[gd_scene format=3 uid="uid://devxwqvvi6icp"]

[ext_resource type="Texture2D" uid="uid://dddd07n2n30fd" path="res://icon.svg" id="1_0e48y"]

[sub_resource type="GDScript" id="GDScript_wtcfe"]
script/source = "extends Sprite2D;



var speed : float = 0.0;
var angular_speed : float = PI;
var rotation_dir : direction = direction.forwards;

# Controls directions that something can go
enum direction {
	forwards = 1,
	right = 1,
	none = 0,
	backwards = -1,
	left = -1,
};
	

func _process(delta : float) -> void:
	if (Input.is_action_pressed(\"ui_left\")):
		rotation_dir = direction.left;
	elif (Input.is_action_pressed(\"ui_right\")):
		rotation_dir = direction.right;
	else:
		rotation_dir = direction.none;
	
	if (Input.is_action_pressed(\"ui_up\")):
		speed += 50;
	elif (Input.is_action_pressed(\"ui_down\")):
		speed -= 50;
		
	speed *= 0.9;
	
	self.rotation += angular_speed * delta * rotation_dir;
	var vel : Vector2 = Vector2.UP.rotated(rotation) * speed;
	self.position += vel * delta;


func _on_button_pressed() -> void:
	set_process(not is_processing());
	self.visible = !self.visible;
"

